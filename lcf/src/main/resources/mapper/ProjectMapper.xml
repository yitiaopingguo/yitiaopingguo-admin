<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lcf.mapper.ProjectMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.lcf.entity.Project">
        <id column="project_id" property="projectId" />
        <result column="userId" property="userid" />
        <result column="title" property="title" />
        <result column="description" property="description" />
        <result column="creatTime" property="creattime" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        project_id, userId, title, description, creatTime, status
    </sql>

    <select id="pageCC" resultType="com.lcf.entity.Project">
        select * from project ${ew.customSqlSegment}
    </select>

</mapper>
